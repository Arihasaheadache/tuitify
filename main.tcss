/* Master Screen - Dead center lock */
Screen {
    background: $background;
    align: center middle; 
    color: #eeeeee;
}

/* Loading Screen Styling */
LoadingScreen {
    align: center middle;
    background: $background 80%; /* Semi-transparent background overlay */
}

LoadingIndicator {
    color: $accent;
    height: 100%;
}

/* Welcome Screen */
#welcome_box {
    width: 60;
    height: 12;
    border: round $primary;
    background: $surface;
    content-align: center middle;
    padding: 1 2;
}

#welcome_label {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $accent;
}

#start_search {
    width: 100%;
    border: round $secondary;
}

/* Player Screen - Every block is exactly 80 wide */
#disk_area {
    width: 80; 
    height: 10;
    content-align: center middle;
    color: $accent;
}

#song_info {
    width: 80; 
    height: 3;
    content-align: center middle;
    text-style: bold;
    margin: 1 0;
}

#player_controls {
    width: 80;
    height: 3;
    content-align: center middle;
}

#time_info {
    width: 18;
    text-align: left;
    color: #888888;
}

#ascii_bar {
    width: 44; 
    text-align: center;
    color: $accent;
    text-style: bold;
}

#vol_info {
    width: 18;
    text-align: right;
    color: #888888;
}

/* Search Results Screen */
#search_container {
    width: 80;
    height: 25;
}

ListView {
    width: 100%;
    height: 1fr;
    border: round $primary;
    background: $surface;
}

ListItem:focus {
    background: $primary 20%;
    color: $primary;
    text-style: bold;
}